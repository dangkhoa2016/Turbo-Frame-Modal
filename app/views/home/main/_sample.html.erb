<div id='example9' class='rounded bg-body-tertiary row mb-3 pt-3'>
  <h4 class='col-12 mb-2'>I - Alert modals</h4>

  <div class='col-md-6'>
    <div class='alert alert-secondary my-4'>
      <%= link_to 'Alert 1', '#', class: 'btn btn-warning',
        data: { turbo_frame: 'modal_frame', alert: 'Sample alert message' } %>
      <p class='text-secondary mb-0 mt-2'>Open modal to show the alert message</p>
    </div>
  </div>
  <div class='col-md-6'>
    <div class='alert bg-purple my-4'>
      <%= link_to 'Alert 2', '#', class: 'btn btn-success',
        data: { turbo_frame: 'sub_modal_frame', alert_selector: '#sample_alert_selector' } %>
      <p class='text-secondary mb-0 mt-2'>Open modal to show the alert message from a selector, example: <code>#sample_alert_selector</code></p>
    </div>

    <div id='sample_alert_selector' class='d-none'>
      <div class='alert alert-danger mb-0'>
        Sample alert message
      </div>
    </div>
  </div>
  <div class='col-md-6'>
    <div class='alert alert-success my-4'>
      <%= link_to 'Alert 1', '#', class: 'btn btn-warning',
        data: { turbo_frame: 'modal_frame', alert: 'Sample alert message', closable: false } %>
      <p class='text-secondary mb-0 mt-2'>Open modal to show the alert message, click outside the modal will not close the modal</p>
    </div>
  </div>
  <div class='col-md-6'>
    <div class='alert alert-danger my-4'>
      <%= link_to 'Alert 2', '#', class: 'btn btn-success',
        data: { turbo_frame: 'sub_modal_frame', alert_selector: '#sample_alert_selector', closable: false } %>
      <p class='text-secondary mb-0 mt-2'>Open modal to show the alert message from a selector,
      click outside the modal will not close the modal, example: <code>#sample_alert_selector</code></p>
    </div>
  </div>
</div>

<div id='example10' class='rounded bg-body-tertiary row mb-3 pt-3'>
